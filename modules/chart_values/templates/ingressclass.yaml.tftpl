# IngressClass `alb` and its parameters, for EKS Auto Mode's built-in ALB
# controller. The chart's ingress.className: alb resolves to this.
#
# Apply it with kubectl, not Terraform: a Kubernetes-flavoured Terraform provider
# has to be configured from the cluster endpoint, which is unknown at plan time
# whenever the cluster itself plans a replacement.
#
# Ordering: IngressClassParams is a CRD that ships with Auto Mode, so this can
# only be applied after the cluster exists — which it does by the time you have
# this output.
---
apiVersion: eks.amazonaws.com/v1
kind: IngressClassParams
metadata:
  name: alb
spec:
  scheme: internet-facing
  # TLS terminates here. Kept out of the chart's ingress annotations on purpose:
  # setting the certificate in both places conflicts.
  certificateARNs:
    - ${acm_certificate_arn}
---
apiVersion: networking.k8s.io/v1
kind: IngressClass
metadata:
  name: alb
spec:
  controller: eks.amazonaws.com/alb
  parameters:
    apiGroup: eks.amazonaws.com
    kind: IngressClassParams
    name: alb
