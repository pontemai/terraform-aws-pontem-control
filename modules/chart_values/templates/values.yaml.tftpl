# pontem-control chart values for this AWS deployment.
#
# Generated by the terraform-aws-pontem-control module — regenerate with
# `terraform output -raw helm_values` rather than editing in place.
#
# Two things this file cannot know, both supplied by Pontem:
#   * gcp.wifAudience below, once Pontem has registered your AWS account and the
#     control-plane runtime role. The chart refuses to install while it still
#     reads REPLACE_ME_PONTEM_SUPPLIED.
#   * image.repository and admin.image.repository — the container images come
#     from Pontem's registry, so pass them at install time
#     (`--set image.repository=...`) or add them here.

# The pods run on AWS and federate into GCP for managed agent packages, rather
# than holding a GCP service account key.
cloudProvider: aws

aws:
  region: ${aws_region}

gcp:
  wifAudience: "${wif_audience}"

credentials:
  existingSecret:
    name: ${credentials_secret_name}

auth:
  userProvider: oidc
  # Supplied as plain values because neither is secret. Left empty, both instead
  # arrive as OIDC_ISSUER / OIDC_AUDIENCE keys in the Secret above.
  oidc:
    issuer: "${oidc_issuer}"
    audience: "${oidc_audience}"

externalDatabase:
  # Password-less DSN: the application rejects a password embedded in the URL and
  # reads DATABASE_PASSWORD from the Secret instead. RDS has a stable DNS
  # endpoint, so there is no proxy sidecar.
  url: "postgresql+psycopg://${db_user}@${db_host}:${db_port}/${db_name}"
  cloudsqlProxy:
    enabled: false

# No object storage. The tenant-files endpoints answer 503 and everything else
# works; the chart has no S3 backend to point at.
blobStorage:
  type: none

# Per-tenant secrets go to AWS Secrets Manager, reached with the pods' ambient
# Pod Identity credentials. This requires cloudProvider: aws, set above.
secretsBackend:
  type: aws

ingress:
  domain: ${app_domain_name}
  # The IngressClass created from the ingress_class_manifest output, which points
  # at EKS Auto Mode's built-in ALB controller.
  className: alb
  # GKE-only feature; TLS here terminates at the ALB using the ACM certificate
  # attached by the IngressClassParams.
  managedCertificate: false
  # Do NOT add scheme or certificate-arn here. Both live in IngressClassParams
  # and setting them in two places conflicts.
  annotations:
    alb.ingress.kubernetes.io/target-type: ip
    alb.ingress.kubernetes.io/listen-ports: '[{"HTTP":80},{"HTTPS":443}]'
    alb.ingress.kubernetes.io/ssl-redirect: "443"

# The ALB controller does not derive its target-group health check from the
# readinessProbe the way the GCE Ingress does, so each service names its path
# explicitly. Without these the default check hits `/`, which neither container
# serves, and the target group never becomes healthy.
api:
  service:
    annotations:
      alb.ingress.kubernetes.io/healthcheck-path: /health

admin:
  service:
    annotations:
      alb.ingress.kubernetes.io/healthcheck-path: /healthz

# Every other chart key is left at its default deliberately:
#
#   observability  Fleet metrics and logs need a GCP backend these pods have no
#                  identity for, so device telemetry endpoints stay off.
#   tracing        Control-plane traces go to Pontem's Honeycomb on a shared key;
#                  it is not a backend to point at your own account.
#   agentCatalog   Set by Pontem alongside wifAudience if you are subscribing to
#                  published agent versions.
#   managedSync    Off until the GCP federation above is live.
